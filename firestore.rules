rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() &&
        currentProfile().role == 'admin' &&
        currentProfile().active == true;
    }

    function isCoordinator() {
      return signedIn() &&
        currentProfile().role == 'coordinator' &&
        currentProfile().active == true &&
        currentProfile().approvalStatus == 'approved';
    }

    function isStaff() {
      return isAdmin() || isCoordinator();
    }

    function isStudent() {
      return signedIn() &&
        currentProfile().role == 'student' &&
        currentProfile().get('enrollmentStatus', '') == 'active' &&
        request.auth.token.get('email_verified', false) == true &&
        request.auth.token.get('student_enrolled', false) == true &&
        currentProfile().active == true;
    }

    // Student accounts can exist before a Program Coordinator is assigned.
    // Map.get(..., null) keeps permission checks valid when coordinatorId is
    // not present yet, while still preventing a student from submitting data
    // under another coordinator's UID.
    function currentCoordinatorId() {
      return currentProfile().get('coordinatorId', null);
    }

    function assignedStudent(studentId) {
      return isCoordinator() &&
        get(/databases/$(database)/documents/users/$(studentId)).data.role == 'student' &&
        get(/databases/$(database)/documents/users/$(studentId)).data.coordinatorId == request.auth.uid;
    }

    function ownStudentRecord(studentId) {
      return isStudent() && studentId == request.auth.uid;
    }

    function coordinatorOwnsResource() {
      return isCoordinator() && resource.data.coordinatorId == request.auth.uid;
    }

    function coordinatorOwnsIncoming() {
      return isCoordinator() && request.resource.data.coordinatorId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (isCoordinator() &&
          resource.data.role == 'student' &&
          resource.data.coordinatorId == request.auth.uid)
      );

      // Students are provisioned by the trusted roster importer.
      allow create: if (
        signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          'email', 'displayName', 'role', 'studentNumber', 'staffId',
          'department', 'approvalStatus', 'active', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() > 1 &&
        request.resource.data.role == 'coordinator' &&
        request.resource.data.studentNumber == null &&
        request.resource.data.staffId is string &&
        request.resource.data.staffId.size() > 0 &&
        request.resource.data.department is string &&
        request.resource.data.department.size() > 0 &&
        request.resource.data.approvalStatus == 'pending' &&
        request.resource.data.active == false
      ) || (isAdmin() && request.resource.data.role != 'student');

      allow update: if isAdmin() || (
        isCoordinator() &&
        assignedStudent(userId) &&
        resource.data.role == 'student' &&
        request.resource.data.role == 'student' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'program', 'department', 'section', 'yearLevel', 'academicYear', 'updatedAt'
        ])
      ) || (
        signedIn() && request.auth.uid == userId &&
        (isStudent() || isCoordinator()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reminderHours']) &&
        request.resource.data.reminderHours is int &&
        request.resource.data.reminderHours >= 1 && request.resource.data.reminderHours <= 720
      ) || (
        signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'phone', 'photoUrl', 'updatedAt'
        ])
      );

      allow delete: if isAdmin();
    }

    function activeRecord() {
      return resource.data.get('archived', false) == false;
    }

    function staysActive() {
      return activeRecord() && request.resource.data.get('archived', false) == false;
    }

    // Archive the existing record in place. Its academic year, ownership,
    // review decision and file references are preserved.
    function archiveTransition(requiredStatus, profile) {
      let next = request.resource.data;
      let keys = next.diff(resource.data).affectedKeys();
      return isAdmin() && activeRecord() && next.archived == true &&
        next.archivedBy == request.auth.uid && next.archivedAt == request.time &&
        resource.data.academicYear is string &&
        (resource.data.status == requiredStatus ||
         (profile && resource.data.status.lower() in ['completed','complete'])) &&
        ((profile && next.status == 'Archived' &&
          keys.hasOnly(['archived','archivedAt','archivedBy','status'])) ||
         (!profile && keys.hasOnly(['archived','archivedAt','archivedBy'])));
    }

    function retainedStudentFile(path, folder) {
      let parts = path.split('/');
      return parts.size() == 3 && parts[0] == resource.data.studentId &&
        parts[1] == folder && parts[2].size() > 0 && !(parts[2] in ['.','..']);
    }

    match /requirements/{requirementId} {
      allow read: if isAdmin() ||
        (isCoordinator() && resource.data.coordinatorId == request.auth.uid) ||
        (isStudent() && resource.data.studentId == request.auth.uid);

      allow create: if false;

      allow update: if archiveTransition('verified', false) &&
        retainedStudentFile(resource.data.storagePath, 'requirements');
      allow update: if staysActive() && (isAdmin() || (
        isCoordinator() && resource.data.coordinatorId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'remarks', 'reviewedBy', 'reviewedAt', 'updatedAt'
        ])
      ));

      allow delete: if isAdmin() && activeRecord();
    }

    match /requirement_versions/{versionId} {
      allow read: if isAdmin() || (
        isCoordinator() &&
        get(/databases/$(database)/documents/requirements/$(resource.data.requirementId)).data.coordinatorId == request.auth.uid
      ) || (
        isStudent() &&
        get(/databases/$(database)/documents/requirements/$(resource.data.requirementId)).data.studentId == request.auth.uid
      );

      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /dtr_entries/{entryId} {
      allow read: if isAdmin() ||
        (isCoordinator() && resource.data.coordinatorId == request.auth.uid) ||
        (isStudent() && resource.data.studentId == request.auth.uid);

      // Attendance creation, clock-in/out timestamps, and early-out exceptions
      // are written by the trusted DTR API using Firebase Admin. The browser
      // cannot create a record or choose its own attendance timestamps.
      allow create: if false;

      function validForApproval() {
        let d = request.resource.data;
        return d.archived == false && d.get('attendanceState','submitted') == 'submitted' &&
          d.academicYear is string && d.academicYear.matches('[0-9]{4}-[0-9]{4}') &&
          d.academicYear == get(/databases/$(database)/documents/users/$(d.studentId)).data.academicYear &&
          d.date is timestamp && d.timeIn is timestamp && d.timeOut is timestamp &&
          d.timeIn >= d.date && d.timeOut > d.timeIn && d.timeOut <= request.time &&
          d.timeOut < d.date + duration.value(25,'h') &&
          d.timeOut < d.get('workDayEnd', d.date + duration.value(1,'d')) &&
          d.breakMinutes is int && d.breakMinutes >= 0 &&
          d.timeIn + duration.value(d.breakMinutes + 1,'m') <= d.timeOut;
      }
      allow update: if archiveTransition('verified', false) &&
        (resource.data.get('checkInPhotoPath', null) == null ||
         retainedStudentFile(resource.data.checkInPhotoPath, 'dtr-checkins'));
      allow update: if staysActive() &&
        (request.resource.data.status != 'verified' || validForApproval() ||
         (isAdmin() && resource.data.status == 'verified' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coordinatorId','updatedAt']))) &&
        (isAdmin() || (isCoordinator() && resource.data.coordinatorId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'remarks', 'reviewedBy', 'reviewedAt', 'updatedAt'
          ])));

      allow delete: if isAdmin() && activeRecord();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || (
        (isStudent() || isStaff()) &&
        resource.data.active == true &&
        (
          resource.data.targetRole == 'all' ||
          resource.data.targetRole == currentProfile().role ||
          resource.data.targetRole == 'user:' + request.auth.uid
        ) &&
        (
          resource.data.targetUserId == null ||
          resource.data.targetUserId == request.auth.uid
        )
      );

      allow create: if isAdmin() || (
        isCoordinator() &&
        request.resource.data.targetUserId is string &&
        request.resource.data.targetRole == 'user:' + request.resource.data.targetUserId &&
        assignedStudent(request.resource.data.targetUserId) &&
        request.resource.data.createdBy == request.auth.uid
      ) || (
        isStudent() &&
        currentCoordinatorId() is string &&
        request.resource.data.targetUserId == currentCoordinatorId() &&
        request.resource.data.targetRole == 'user:' + currentCoordinatorId() &&
        request.resource.data.createdBy == request.auth.uid
      );

      allow update: if isAdmin() || (
        (isStudent() || isStaff()) &&
        resource.data.active == true &&
        (
          resource.data.targetRole == 'all' ||
          resource.data.targetRole == currentProfile().role ||
          resource.data.targetRole == 'user:' + request.auth.uid
        ) &&
        (
          resource.data.targetUserId == null ||
          resource.data.targetUserId == request.auth.uid
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'readBy', 'dismissedBy', 'updatedAt'
        ]) &&
        request.resource.data.get('readBy', []) is list &&
        resource.data.get('readBy', []) is list &&
        request.resource.data.get('dismissedBy', []) is list &&
        resource.data.get('dismissedBy', []) is list &&
        request.resource.data.get('readBy', []).hasAll(
          resource.data.get('readBy', [])
        ) &&
        request.resource.data.get('readBy', []).hasOnly(
          resource.data.get('readBy', []).concat([request.auth.uid])
        ) &&
        request.resource.data.get('dismissedBy', []).hasAll(
          resource.data.get('dismissedBy', [])
        ) &&
        request.resource.data.get('dismissedBy', []).hasOnly(
          resource.data.get('dismissedBy', []).concat([request.auth.uid])
        ) &&
        (
          request.auth.uid in request.resource.data.get('readBy', []) ||
          request.auth.uid in request.resource.data.get('dismissedBy', [])
        )
      );

      allow delete: if isAdmin();
    }

    match /moas/{moaId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /partner_institutions/{partnerId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /requirement_definitions/{definitionId} {
      allow read: if isStudent() || isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /internship_profiles/{studentId} {
      allow read: if isAdmin() ||
        (isCoordinator() && resource.data.coordinatorId == request.auth.uid) ||
        (isStudent() && request.auth.uid == studentId);

      allow create: if request.resource.data.get('archived', false) == false &&
        request.resource.data.get('status','') != 'Archived' && (isAdmin() || (
        isCoordinator() &&
        assignedStudent(studentId) &&
        request.resource.data.coordinatorId == request.auth.uid
      ));

      allow update: if archiveTransition('Completed', true);
      allow update: if staysActive() && request.resource.data.get('status','') != 'Archived' && (isAdmin() || (
        isCoordinator() &&
        assignedStudent(studentId) &&
        resource.data.coordinatorId == request.auth.uid &&
        request.resource.data.coordinatorId == request.auth.uid
      ));

      allow delete: if isAdmin() && activeRecord();
    }

    match /evaluation_status/{statusId} {
      // Students can read only their own non-confidential status records.
      // The document ID is separate from the private evaluation link token.
      allow read: if isStudent() &&
        resource.data.studentId == request.auth.uid;

      // Only the trusted backend creates student-visible status records.
      allow create: if false;
      // Only the trusted backend can change pending to submitted.
      allow update, delete: if false;
    }

    match /supervisor_evaluations/{token} {
      // Industry supervisor access is handled by the trusted /api/evaluation
      // application-server endpoint. Firestore itself is never public.
      allow read: if isAdmin() ||
        (isCoordinator() && resource.data.coordinatorId == request.auth.uid);

      // Only the trusted backend creates confidential evaluation records.
      allow create: if false;
      // Admins may maintain archive/assignment metadata, but cannot edit
      // submitted ratings, comments, or the evaluation status.
      // Coordinators may only clear a submitted record's sync-pending flag.
      allow update: if archiveTransition('submitted', false);
      allow update: if staysActive() && ((
        isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'academicYear',
          'coordinatorId', 'updatedAt', 'statusSyncPending'
        ])
      ) || (
        isCoordinator() &&
        resource.data.coordinatorId == request.auth.uid &&
        resource.data.status == 'submitted' &&
        resource.data.statusSyncPending == true &&
        request.resource.data.statusSyncPending == false &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'statusSyncPending', 'updatedAt'
        ])
      ));

      allow delete: if isAdmin() && activeRecord();
    }

    match /academic_archives/{archiveId} {
      allow read: if isAdmin() || isCoordinator();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    match /activity_logs/{logId} {
      allow read: if isAdmin() ||
        (isCoordinator() && resource.data.userId == request.auth.uid);
      allow create: if (isStudent() || isStaff()) &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /tor_records/{recordId} {
      allow read, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
